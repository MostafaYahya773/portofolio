# Copy to .env.local and use the publishable key from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Set the public HTTPS URL when deploying, for canonical URLs and sharing.
SITE_URL=http://localhost:3000
